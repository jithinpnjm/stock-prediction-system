# Training image for the BankNifty big-move model. Built and run on the
# Nebius L40S VM (torch.cuda.is_available() must be True inside it — the
# base image ships CUDA runtime, the L40S driver is provided by the host
# via nvidia-container-toolkit, no CUDA toolkit install needed on the VM
# itself beyond the driver).
FROM pytorch/pytorch:2.4.0-cuda12.1-cudnn9-runtime

WORKDIR /workspace

COPY infra/requirements.train.txt /workspace/requirements.train.txt
RUN pip install --no-cache-dir -r requirements.train.txt

COPY data_pipeline/ /workspace/data_pipeline/
COPY training/ /workspace/training/

CMD ["python3", "-c", "import torch; print('CUDA available:', torch.cuda.is_available()); print(torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'no GPU visible')"]
